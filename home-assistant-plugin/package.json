{
  "name": "pebble-home-assistant-plugin",
  "author": "Eric McCormick",
  "version": "0.1.0",
  "pebble": {
    "displayName": "Home Assistant Bridge",
    "uuid": "a74370b6-929c-4ec0-b7ee-2fc6fca8db57",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "projectType": "plugin",
    "configPage": "src/config.html",
    "usesPermissions": [
      "Internet",
      "LocalNetwork"
    ],
    "plugin": {
      "description": "Reusable Home Assistant bridge for Pebble: entity readings, API discovery, conversation, templates, and permission-gated device control. User-configured HTTPS server and private token storage.",
      "script": "src/plugin/index.js",
      "definesPermissions": [
        {
          "name": "HomeRead",
          "label": "Read Home Assistant entities and configuration",
          "kind": "read"
        },
        {
          "name": "HomeConverse",
          "label": "Send messages to Home Assistant conversation agent",
          "kind": "exfiltrating"
        },
        {
          "name": "HomeControl",
          "label": "Control Home Assistant devices and services",
          "kind": "dangerous"
        }
      ],
      "sources": [
        {
          "category": "home_assistant",
          "items": [
            "entity"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "entity_id": [
              "shortText"
            ],
            "domain": [
              "shortText"
            ],
            "state": [
              "shortText",
              "longText"
            ],
            "value": [
              "numericValue"
            ],
            "on": [
              "boolean"
            ],
            "unit": [
              "shortText"
            ]
          },
          "supportsMultiple": true,
          "suggestedRefreshIntervalSec": 30,
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "category": "home_assistant",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean"
            ]
          },
          "supportsMultiple": false,
          "suggestedRefreshIntervalSec": 120,
          "callerPermissions": [
            "HomeRead"
          ]
        }
      ],
      "actions": [
        {
          "name": "get_state",
          "description": "Read one Home Assistant entity and its attributes.",
          "parameters": {
            "type": "object",
            "properties": {
              "entity_id": {
                "type": "string"
              }
            },
            "required": [
              "entity_id"
            ]
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "list_states",
          "description": "Read Home Assistant entities, optionally filtered by domain. Returns a bounded list.",
          "parameters": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "read_api",
          "description": "Read selected Home Assistant API endpoints without exposing authentication.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "conversation",
          "description": "Send a text request to the configured Home Assistant agent.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "agent_id": {
                "type": "string"
              },
              "conversation_id": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "render_template",
          "description": "Evaluate a Home Assistant Jinja template. Only grant to trusted watch apps.",
          "parameters": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              }
            },
            "required": [
              "template"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        },
        {
          "name": "call_service",
          "description": "Invoke any Home Assistant service; may unlock doors or trigger dangerous operations.",
          "parameters": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "data": {
                "type": "object"
              },
              "target": {
                "type": "object"
              }
            },
            "required": [
              "domain",
              "service"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        },
        {
          "name": "fire_event",
          "description": "Fire a Home Assistant event to trigger automations; may produce sensitive effects.",
          "parameters": {
            "type": "object",
            "properties": {
              "event_type": {
                "type": "string"
              },
              "event_data": {
                "type": "object"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        }
      ]
    }
  }
}
